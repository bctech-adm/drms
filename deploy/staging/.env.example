# ProyekKas STAGING — copy to /opt/infra/staging/drms-proyekkas/.env (mode 600, root). NO SECRETS HERE.
# Secrets are FILES in ./secrets/ next to docker-compose.yml (see bottom), never variables.

# --- images (GHCR, pinned by tag AND digest once CI publishes them) ---
PK_WEB_IMAGE=ghcr.io/<org>/proyekkas-web:0.1.0@sha256:<digest>
PK_MIGRATE_IMAGE=ghcr.io/<org>/proyekkas-migrate:0.1.0@sha256:<digest>

# --- app ---
APP_URL=https://drms-kas.staging.bimacreative.tech
LOG_LEVEL=info

# --- Keycloak (realm drms-staging) ---
# Public issuer: tokens carry this iss (hostname v2, verified in spike b).
OIDC_ISSUER=https://auth.bimacreative.tech/realms/drms-staging
OIDC_WEB_CLIENT_ID=proyekkas-web
OIDC_MOBILE_CLIENT_ID=proyekkas-mobile
# Admin REST base (WITHOUT /admin). Reached through network drms-kc-admin-stg where the alias
# auth.bimacreative.tech resolves to Traefik; router allows /admin/realms/drms-staging/… + token.
KC_ADMIN_BASE_URL=https://auth.bimacreative.tech
KC_REALM=drms-staging
KC_ADMIN_CLIENT_ID=proyekkas-admin-api

# --- outbound mail (all-or-nothing; password = secret FILE smtp_password, see bottom) ---
# From MUST equal SMTP_USER (display name via SMTP_FROM_NAME). 587 = STARTTLS required; 465 = implicit TLS.
# Server limit 30 mails/hour per mailbox (burst 10); the app stays at ≤ 29/h, burst 5.
SMTP_HOST=mail.bimacreative.tech
SMTP_PORT=587
SMTP_USER=no-reply@bimacreative.tech
SMTP_FROM_ADDRESS=no-reply@bimacreative.tech
SMTP_FROM_NAME=ProyekKas

# --- optional: first admin for the seed (existing Keycloak user of realm drms-staging) ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_KEYCLOAK_SUB=

# --- optional: REAL master data for the seed (employees, bank accounts, vehicles, …) ---
# The repo only ships FICTIONAL seed data (public repo). The real dataset is an untracked JSON
# file of the same shape (apps/web/src/seed/data.ts → SeedDataSchema), held by the project Lead.
# Mount it into the seed container like the other secrets (see the comment on drms-pk-stg-seed in
# docker-compose.yml) and point SEED_DATA_FILE at the in-container path:
# SEED_DATA_FILE=/run/secrets/seed_data
# The seed never overwrites existing rows (natural keys) → load the real data on a fresh database,
# otherwise fictional employees with the same codes stay as they are.

# --- optional, one-off: UAT seed (apps/web/src/seed/uat.ts) — NOT an .env variable ---
# Prepares staging for a manual end-to-end test (after the base seed): app users linked to
# EXISTING Keycloak users (no Keycloak call), employees UJI-STAFF/UJI-PM/UJI-FIN/UJI-OWN, OPS-PB
# manager = PM (only if empty), a fictional bank account, project UJI-PRJ + team assignments.
# Idempotent; prints {"uatSeed":{…created/linked/skipped…}}. Pass the list at run time only:
#   export UAT_USERS='[{"email":"staff.uji@proyekkas.test","name":"Staff Uji","role":"pk-staff","keycloakSub":"<uuid>"},
#                      {"email":"pm.uji@proyekkas.test","name":"PM Uji","role":"pk-pm","keycloakSub":"<uuid>"}, …]'
#   docker compose --profile seed run --rm -e UAT_USERS drms-pk-stg-seed \
#     node /app/node_modules/payload/bin.js run src/seed/uat.ts
# role ∈ pk-staff|pk-pm|pk-finance|pk-owner (one user per role; staff + pm required).

# --- secret FILES (create once; chown 1001:1001, chmod 0400; no trailing newline needed) ---
# ./secrets/database_url_owner.secret     postgres://pk_drms_stg_owner:<PG_PK_DRMS_STG_OWNER_PASSWORD>@postgres:5432/pk_drms_stg
# ./secrets/database_url_app.secret       postgres://pk_drms_stg_app:<PG_PK_DRMS_STG_APP_PASSWORD>@postgres:5432/pk_drms_stg
# ./secrets/payload_secret.secret         ≥ 32 random chars (e.g. openssl rand -hex 32)
# ./secrets/oidc_web_client_secret.secret from /opt/infra/identity/keycloak/secrets/drms-staging-proyekkas-web.secret
# ./secrets/kc_admin_client_secret.secret from /opt/infra/identity/keycloak/secrets/drms-staging-proyekkas-admin-api.secret
# ./secrets/smtp_password.secret          mailbox password of no-reply@bimacreative.tech (provisioned by infra, 32 chars, no newline)
# DB passwords: /opt/infra/postgres/.env (PG_PK_DRMS_STG_{OWNER,APP}_PASSWORD). URL-encode special characters.
